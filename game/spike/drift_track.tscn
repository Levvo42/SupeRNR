[sub_resource type="Shader" id="Shader_terrain"]
code = "shader_type spatial;
render_mode cull_disabled;
// Vertex colour carries surface weights: r = road, g = ditch depth, b = parking asphalt.
// A world-space checker on every surface makes speed and sliding readable.
uniform vec3 grass_a : source_color = vec3(0.2, 0.34, 0.16);
uniform vec3 grass_b : source_color = vec3(0.25, 0.4, 0.2);
uniform vec3 road_a : source_color = vec3(0.14, 0.14, 0.15);
uniform vec3 road_b : source_color = vec3(0.19, 0.19, 0.2);
uniform vec3 ditch_a : source_color = vec3(0.33, 0.27, 0.15);
uniform vec3 ditch_b : source_color = vec3(0.38, 0.31, 0.18);
uniform vec3 lot_a : source_color = vec3(0.3, 0.3, 0.32);
uniform vec3 lot_b : source_color = vec3(0.34, 0.34, 0.36);
uniform float cell_size = 4.0;
varying vec3 world_pos;
void vertex() { world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
	vec2 cell = floor(world_pos.xz / cell_size);
	float checker = mod(cell.x + cell.y, 2.0);
	vec3 c = mix(grass_a, grass_b, checker);
	c = mix(c, mix(ditch_a, ditch_b, checker), COLOR.g);
	c = mix(c, mix(road_a, road_b, checker), COLOR.r);
	c = mix(c, mix(lot_a, lot_b, checker), COLOR.b);
	ALBEDO = c;
	ROUGHNESS = 0.9;
}
"

[sub_resource type="ShaderMaterial" id="Mat_terrain"]
render_priority = 0
shader = SubResource("Shader_terrain")

[sub_resource type="Shader" id="Shader_checker"]
code = "shader_type spatial;
// World-space checker, used for the red and white rails.
uniform vec3 color_a : source_color = vec3(0.8, 0.1, 0.08);
uniform vec3 color_b : source_color = vec3(0.92, 0.92, 0.92);
uniform float cell_size = 2.0;
varying vec3 world_pos;
void vertex() { world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
	vec2 cell = floor(world_pos.xz / cell_size);
	ALBEDO = mix(color_a, color_b, mod(cell.x + cell.y, 2.0));
	ROUGHNESS = 0.7;
}
"

