[sub_resource type="Shader" id="Shader_checker"]
code = "shader_type spatial;
render_mode cull_disabled;
// World-space checker so speed and sliding are visible. Same pattern on every mesh.
uniform vec3 color_a : source_color = vec3(0.32);
uniform vec3 color_b : source_color = vec3(0.42);
uniform float cell_size = 4.0;
varying vec3 world_pos;
void vertex() { world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
	vec2 cell = floor(world_pos.xz / cell_size);
	float checker = mod(cell.x + cell.y, 2.0);
	ALBEDO = mix(color_a, color_b, checker);
	ROUGHNESS = 0.9;
}
"

